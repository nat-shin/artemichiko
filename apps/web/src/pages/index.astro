---
// ArteMichiko — Home nivel Awwwards (preloader + text reveal + zoom-parallax + máscaras)
// Identidad: blanco/negro/dorado/jade · MAESTRO E.35/E.38 · Video Canal 11 como modal
import Layout from "../layouts/Layout.astro";
import VideoModal from "../components/VideoModal.astro";
---

<Layout title="Centro Cultural Académico de Dibujo y Pintura" description="ArteMichiko — academia de arte con sistema Oriental único en México. Dibujo, pintura, grabado y más.">

  <!-- ═══════ PRELOADER (contador 0→100 + cortina que se levanta) ═══════ -->
  <div id="preloader" class="fixed inset-0 z-[9998] flex items-center justify-center bg-tinta-negra" aria-hidden="true">
    <div class="text-center">
      <p class="font-display text-2xl text-lienzo-blanco">Arte<span class="text-oro-brillo">Michiko</span></p>
      <p id="preloader-count" class="mt-4 font-mono text-5xl text-oro-brillo tabular-nums">0</p>
      <div class="mx-auto mt-4 h-px w-40 overflow-hidden bg-lienzo-blanco/10">
        <div id="preloader-bar" class="h-full w-0 bg-oro-brillo"></div>
      </div>
    </div>
  </div>

  <!-- ═══════ HERO — text reveal por caracteres + textura ═══════ -->
  <section class="relative overflow-hidden pt-40 pb-24 md:pt-48 md:pb-32">
    <!-- Textura de grano + tinta lavada (clases globales; opacidad WCAG ≤0.08 en claro) -->
    <div class="grain absolute inset-0 pointer-events-none opacity-[0.06]" aria-hidden="true"></div>
    <div class="ink-wash-suave absolute inset-0 pointer-events-none opacity-40" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6">
      <div class="sello mb-10 flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-sm border-2 border-jade-profundo font-display text-jade-tinta" aria-hidden="true">印</span>
        <p class="font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Centro Cultural · CDMX</p>
      </div>

      <h1 class="max-w-4xl font-display text-6xl leading-[1.02] font-semibold tracking-tight md:text-9xl">
        <span class="reveal-line block overflow-hidden"><span class="reveal-inner inline-block">El arte como</span></span>
        <span class="reveal-line block overflow-hidden">
          <span class="reveal-inner inline-block bg-gradient-to-r from-oro-viejo via-oro-brillo to-oro-arena bg-clip-text text-transparent">estado del alma</span>
        </span>
      </h1>

      <div class="mt-10 flex max-w-2xl flex-col gap-6">
        <p class="fade-up text-lg leading-relaxed text-tinta-grafito md:text-xl">
          Sistema Oriental único en México para revelar los talentos del alumnado: dibujo, pintura, grabado y técnicas tradicionales.
        </p>
        <div class="fade-up flex flex-wrap gap-4">
          <a href="/inscripcion" data-cursor class="rounded-full bg-oro-brillo px-8 py-3 font-medium text-tinta-negra shadow-[0_4px_24px_rgba(212,175,55,0.3)] transition-all hover:scale-105 hover:bg-oro-viejo">
            Explorar cursos
          </a>
          <a href="/galeria" data-cursor class="rounded-full border border-tinta-negra px-8 py-3 font-medium transition-colors hover:border-jade-base hover:text-jade-profundo">
            Ver galería
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ MARQUEE de técnicas (banda de ritmo, pausa en hover) ═══════ -->
  <section class="seigaiha border-y border-tinta-negra/10 bg-tinta-negra py-4 overflow-hidden" aria-label="Técnicas de la academia">
    <div class="marquee flex whitespace-nowrap" data-marquee>
      <div class="marquee-track flex shrink-0 gap-12 pr-12 font-mono text-sm tracking-[0.25em] text-lienzo-hueso/80 uppercase">
        <span>Dibujo</span><span class="text-oro-brillo">◆</span>
        <span>Pintura</span><span class="text-oro-brillo">◆</span>
        <span>Grabado</span><span class="text-oro-brillo">◆</span>
        <span>Acuarela</span><span class="text-oro-brillo">◆</span>
        <span>Óleo</span><span class="text-oro-brillo">◆</span>
        <span>Caligrafía</span><span class="text-oro-brillo">◆</span>
        <span>Técnica Interna</span><span class="text-oro-brillo">◆</span>
      </div>
      <div class="marquee-track flex shrink-0 gap-12 pr-12 font-mono text-sm tracking-[0.25em] text-lienzo-hueso/80 uppercase" aria-hidden="true">
        <span>Dibujo</span><span class="text-oro-brillo">◆</span>
        <span>Pintura</span><span class="text-oro-brillo">◆</span>
        <span>Grabado</span><span class="text-oro-brillo">◆</span>
        <span>Acuarela</span><span class="text-oro-brillo">◆</span>
        <span>Óleo</span><span class="text-oro-brillo">◆</span>
        <span>Caligrafía</span><span class="text-oro-brillo">◆</span>
        <span>Técnica Interna</span><span class="text-oro-brillo">◆</span>
      </div>
    </div>
  </section>

  <!-- ═══════ GALERÍA DESTACADA — sticky zoom-parallax + mask reveal ═══════ -->
  <section id="galeria-destacada" class="zoom-gallery relative overflow-hidden">
    <div class="zoom-inner mx-auto max-w-7xl px-6 py-24">
      <div class="zoom-head mb-16">
        <p class="font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Obras destacadas</p>
        <h2 class="mt-4 max-w-2xl font-display text-5xl font-semibold tracking-tight md:text-6xl">
          El taller en <span class="text-oro-brillo">movimiento</span>
        </h2>
      </div>

      <div class="zoom-stage relative grid gap-6 md:grid-cols-3">
        <!-- Columna izquierda (sube) -->
        <div class="zoom-col-left space-y-6">
          <figure class="mask-frame group relative aspect-[3/4] overflow-hidden rounded-sm" data-mask>
            <img src="https://placehold.co/800x1066/F5F0E6/11110E?text=Obra+01" alt="Obra destacada 01 — lugar para imagen real" loading="lazy" width="800" height="1066" class="mask-img h-full w-full object-cover" data-parallax />
            <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-4 font-mono text-xs text-lienzo-hueso">
              Grafito sobre papel · 01
            </figcaption>
          </figure>
          <figure class="mask-frame group relative aspect-[3/4] overflow-hidden rounded-sm" data-mask>
            <img src="https://placehold.co/800x1066/EDE3D0/11110E?text=Obra+02" alt="Obra destacada 02 — lugar para imagen real" loading="lazy" width="800" height="1066" class="mask-img h-full w-full object-cover" data-parallax />
            <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-4 font-mono text-xs text-lienzo-hueso">
              Acuarela · 02
            </figcaption>
          </figure>
        </div>

        <!-- Columna central (contra-escala) -->
        <div class="zoom-col-center flex items-center">
          <figure class="mask-frame group relative aspect-[3/4] overflow-hidden rounded-sm" data-mask>
            <img src="https://placehold.co/800x1066/11110E/D4AF37?text=Obra+Central" alt="Obra central — lugar para imagen real" loading="lazy" width="800" height="1066" class="mask-img h-full w-full object-cover" data-parallax data-scale />
            <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-4 font-mono text-xs text-lienzo-hueso">
              Óleo · Pieza central
            </figcaption>
          </figure>
        </div>

        <!-- Columna derecha (baja) -->
        <div class="zoom-col-right space-y-6">
          <figure class="mask-frame group relative aspect-[3/4] overflow-hidden rounded-sm" data-mask>
            <img src="https://placehold.co/800x1066/EFE6D4/11110E?text=Obra+03" alt="Obra destacada 03 — lugar para imagen real" loading="lazy" width="800" height="1066" class="mask-img h-full w-full object-cover" data-parallax />
            <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-4 font-mono text-xs text-lienzo-hueso">
              Tinta china · 03
            </figcaption>
          </figure>
          <figure class="mask-frame group relative aspect-[3/4] overflow-hidden rounded-sm" data-mask>
            <img src="https://placehold.co/800x1066/E2E8DF/11110E?text=Obra+04" alt="Obra destacada 04 — lugar para imagen real" loading="lazy" width="800" height="1066" class="mask-img h-full w-full object-cover" data-parallax />
            <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-4 font-mono text-xs text-lienzo-hueso">
              Grabado · 04
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ PILARES (border reveal + hover jade) ═══════ -->
  <section class="washi border-t border-tinta-negra/10">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
      <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">La academia</p>
      <h2 class="fade-up mt-4 max-w-2xl font-display text-5xl font-semibold tracking-tight md:text-6xl">
        Tres caminos hacia <span class="text-oro-brillo">la maestría</span>
      </h2>

      <div class="mt-16 grid gap-10 md:grid-cols-3">
        <article class="fade-up group border-t-2 border-tinta-negra pt-8 transition-colors hover:border-jade-base">
          <p class="font-mono text-sm text-jade-profundo">01 · Dibujo</p>
          <h3 class="mt-4 font-display text-3xl font-semibold">El fundamento</h3>
          <p class="mt-3 leading-relaxed text-tinta-grafito">Del trazo al volumen. Grafito, carboncillo y tinta — la base de toda expresión.</p>
        </article>
        <article class="fade-up group border-t-2 border-tinta-negra pt-8 transition-colors hover:border-jade-base">
          <p class="font-mono text-sm text-jade-profundo">02 · Pintura</p>
          <h3 class="mt-4 font-display text-3xl font-semibold">El color</h3>
          <p class="mt-3 leading-relaxed text-tinta-grafito">Óleo, acuarela y acrílico. La luz y la emoción sobre la tela.</p>
        </article>
        <article class="fade-up group border-t-2 border-tinta-negra pt-8 transition-colors hover:border-jade-base">
          <p class="font-mono text-sm text-jade-profundo">03 · Técnica Interna</p>
          <h3 class="mt-4 font-display text-3xl font-semibold">El sistema Oriental</h3>
          <p class="mt-3 leading-relaxed text-tinta-grafito">Un método único en México que revela los talentos del alumnado desde adentro.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════ COMUNIDAD (redes + prueba social) ═══════ -->
  <section class="relative overflow-hidden bg-tinta-negra text-lienzo-blanco">
    <!-- Tinta lavada + grano (oscuras: grano 0.10–0.15) -->
    <div class="ink-wash absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="grain absolute inset-0 pointer-events-none opacity-[0.12]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-24 md:py-32">
      <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-claro uppercase">En los medios</p>
      <h2 class="fade-up mt-4 max-w-3xl font-display text-5xl font-semibold tracking-tight md:text-6xl">
        El círculo <span class="bg-gradient-to-r from-oro-viejo via-oro-brillo to-oro-arena bg-clip-text text-transparent">del arte</span>
      </h2>
      <p class="fade-up mx-auto mt-6 max-w-xl leading-relaxed text-lienzo-hueso/70">
        Talleres abiertos, exposiciones y el colectivo de artistas que sostienen ArteMichiko. Mira la presentación de nuestra academia en el programa cultural del Canal Once.
      </p>
      <div class="fade-up mt-10 flex flex-wrap items-center gap-4">
        <VideoModal
          id="video-canal11"
          videoId="KsFEtwfALnQ"
          title="ArteMichiko en Canal Once · Programa D Todo"
          label="Ver video de la academia"
        />
        <a href="https://www.instagram.com/arte_michiko" target="_blank" rel="noopener" data-cursor class="rounded-full border border-lienzo-hueso/25 px-6 py-3 text-sm transition-all hover:border-jade-base hover:text-jade-claro">Instagram</a>
        <a href="https://www.facebook.com/centroculturalmichiko" target="_blank" rel="noopener" data-cursor class="rounded-full border border-lienzo-hueso/25 px-6 py-3 text-sm transition-all hover:border-jade-base hover:text-jade-claro">Facebook</a>
        <a href="https://www.youtube.com/@centroculturalacademicoded7862" target="_blank" rel="noopener" data-cursor class="rounded-full border border-lienzo-hueso/25 px-6 py-3 text-sm transition-all hover:border-jade-base hover:text-jade-claro">YouTube</a>
        <a href="https://www.tiktok.com" target="_blank" rel="noopener" data-cursor class="rounded-full border border-lienzo-hueso/25 px-6 py-3 text-sm transition-all hover:border-jade-base hover:text-jade-claro">TikTok</a>
      </div>
    </div>
  </section>

  <!-- ═══════ CTA FINAL → WhatsApp ═══════ -->
  <section class="relative overflow-hidden">
    <div class="ink-wash-suave absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
      <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Comienza tu camino</p>
      <h2 class="fade-up mt-6 font-display text-5xl font-semibold tracking-tight md:text-7xl">
        El arte <span class="bg-gradient-to-r from-oro-viejo via-oro-brillo to-oro-arena bg-clip-text text-transparent">te espera</span>
      </h2>
      <p class="fade-up mx-auto mt-6 max-w-xl leading-relaxed text-tinta-grafito">
        Escribe a nuestro WhatsApp y te contamos todo: cursos, horarios y el método que hace única a la academia.
      </p>
      <a
        href="https://wa.me/5215512595906?text=Hola%20ArteMichiko%2C%20quiero%20conocer%20los%20cursos"
        target="_blank"
        rel="noopener"
        data-cursor
        class="fade-up mt-10 inline-flex items-center gap-3 rounded-full bg-oro-brillo px-10 py-4 font-medium text-tinta-negra shadow-[0_8px_40px_rgba(212,175,55,0.35)] transition-all hover:scale-105 hover:bg-oro-viejo"
      >
        <span class="text-lg" aria-hidden="true">✆</span>
        Inscribirme por WhatsApp
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Tinta lavada suave para secciones claras (hero / CTA final).
     La tinta lavada oscura (.ink-wash) vive en global.css. */
  .ink-wash-suave {
    background:
      radial-gradient(ellipse 60% 40% at 15% 20%, rgba(0,166,107,0.08), transparent 70%),
      radial-gradient(ellipse 50% 35% at 85% 75%, rgba(212,175,55,0.06), transparent 70%),
      radial-gradient(ellipse 40% 30% at 70% 15%, rgba(17,17,14,0.04), transparent 60%);
  }

  /* Reveal por línea (máscara overflow-hidden + translateY) */
  .reveal-inner { will-change: transform; }

  /* Mask reveal de imágenes: la obra "viaja dentro de su marco" */
  .mask-frame { position: relative; }
  .mask-img {
    will-change: transform;
    transform: scale(1.12);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mask-frame:hover .mask-img { transform: scale(1.05); }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    // ── 1. PRELOADER: contador 0→100 + cortina ──
    const counter = { value: 0 };
    const preloader = document.getElementById("preloader");
    const countEl = document.getElementById("preloader-count");
    const barEl = document.getElementById("preloader-bar");

    const preTl = gsap.timeline({
      onComplete: () => {
        preloader?.remove();
        // Entrega el hero inmediatamente después
        gsap.set(".reveal-inner", { y: "110%" });
        gsap.to(".reveal-inner", { y: "0%", duration: 1, ease: "power4.out", stagger: 0.12 });

        // ── 1b. TEXT SCRAMBLE: "estado del alma" se resuelve tras el reveal ──
        const goldTarget = document.querySelector<HTMLElement>(".reveal-inner.bg-gradient-to-r");
        if (goldTarget && window.matchMedia("(pointer: fine)").matches && window.innerWidth > 768) {
          const finalText = goldTarget.textContent ?? "";
          const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*";
          const scramble = { p: 0 };
          gsap.delayedCall(1.9, () => {
            gsap.to(scramble, {
              p: 1,
              duration: 1.2,
              ease: "power3.out",
              onUpdate: () => {
                const revealCount = Math.floor(scramble.p * finalText.length);
                let out = "";
                for (let i = 0; i < finalText.length; i++) {
                  const ch = finalText[i];
                  out += ch === " " ? " " : i < revealCount ? ch : chars[Math.floor(Math.random() * chars.length)];
                }
                goldTarget.textContent = out;
              },
              onComplete: () => {
                goldTarget.textContent = finalText;
              },
            });
          });
        }
      },
    });
    preTl.to(counter, {
      value: 100,
      duration: 1.6,
      ease: "power2.inOut",
      onUpdate: () => {
        if (countEl) countEl.textContent = String(Math.round(counter.value));
        if (barEl) barEl.style.width = `${counter.value}%`;
      },
    });
    preTl.to(preloader, { yPercent: -100, duration: 0.9, ease: "power4.inOut" }, "+=0.15");
    // Fallback: si algo falla, quitar el preloader a los 4s
    setTimeout(() => preloader?.remove(), 4000);

    // ── 2. Fade-ups (secciones) ──
    gsap.utils.toArray(".fade-up").forEach((el) => {
      gsap.from(el, {
        opacity: 0,
        y: 32,
        duration: 0.9,
        ease: "expo.out",
        scrollTrigger: { trigger: el, start: "top 88%" },
      });
    });

    // ── 3. MASK REVEAL de imágenes (la obra viaja en su marco) ──
    gsap.utils.toArray("[data-mask]").forEach((frame) => {
      const img = frame.querySelector(".mask-img");
      if (!img) return;
      gsap.fromTo(
        frame,
        { clipPath: "inset(100% 0 0 0)" },
        {
          clipPath: "inset(0% 0 0 0)",
          duration: 1.2,
          ease: "power4.out",
          scrollTrigger: { trigger: frame, start: "top 85%" },
        }
      );
      // Parallax interno: la imagen se desplaza dentro de su marco
      gsap.to(img, {
        yPercent: -10,
        ease: "none",
        scrollTrigger: { trigger: frame, scrub: 0.6 },
      });
    });

    // ── 4. STICKY ZOOM-PARALLAX en la galería destacada ──
    const stage = document.querySelector(".zoom-stage");
    if (stage) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".zoom-gallery",
          start: "top top",
          end: "+=180%",
          scrub: 1,
          pin: ".zoom-gallery",
          anticipatePin: 1,
        },
      });
      tl.to(stage, { scale: 1.25, ease: "none" }, 0);
      tl.to(".zoom-col-left", { yPercent: -14, ease: "none" }, 0);
      tl.to(".zoom-col-right", { yPercent: 8, ease: "none" }, 0);
      tl.to("[data-scale]", { scale: 0.9, ease: "none" }, 0);
    }

    // ── 5. MARQUEE infinito (pausa en hover) ──
    gsap.utils.toArray("[data-marquee]").forEach((marquee) => {
      const tracks = marquee.querySelectorAll(".marquee-track");
      gsap.to(tracks, {
        xPercent: -100,
        repeat: -1,
        duration: 28,
        ease: "none",
      });
      marquee.addEventListener("mouseenter", () => gsap.to(tracks, { timeScale: 0.2, duration: 0.4 }));
      marquee.addEventListener("mouseleave", () => gsap.to(tracks, { timeScale: 1, duration: 0.4 }));
    });
  }
</script>
