---
// ArteMichiko — Ficha de curso dinámica (getStaticPaths, static output)
// Identidad: blanco/negro/dorado/jade · MAESTRO E.35/E.38
import Layout from "../../layouts/Layout.astro";

export interface Curso {
	slug: string;
	titulo: string;
	nivel: string;
	duracion: string;
	horarios: string;
	modalidad: string;
	docente: string;
	docenteBio: string;
	descripcion: string;
	imagen: string;
	queAprenderas: string[];
	materiales: string[];
}

export function getStaticPaths() {
	const cursos: Curso[] = [
		{
			slug: "dibujo-fundamentos",
			titulo: "Dibujo Fundamentos",
			nivel: "Principiante",
			duracion: "12 semanas · 2 sesiones/semana",
			horarios: "Lunes y miércoles 10:00–12:00 · Sábados 9:00–13:00",
			modalidad: "Presencial · grupos reducidos",
			docente: "Lic. Carmen Suárez López",
			docenteBio:
				"Egresada de la Academia de San Carlos, especialista en anatomía artística. Quince años enseñando a ver antes de dibujar.",
			descripcion:
				"El dibujo no es una habilidad de la mano: es una forma de mirar. Este curso construye la base de toda la academia — línea, proporción, claroscuro y composición — con un método progresivo que acompaña a quien nunca ha dibujado hasta lograr trazos con intención propia.",
			imagen:
				"https://placehold.co/1200x800/E8E2D5/11110E?text=Dibujo+Fundamentos",
			queAprenderas: [
				"Control de línea, gesto y presión sobre el papel",
				"Proporción, encuadre y perspectiva básica",
				"Claroscuro y volumen con grafito y carboncillo",
				"Composición y ritmo visual",
				"Introducción a la tinta y al trazo de influencia Oriental",
			],
			materiales: [
				"Grafitos HB, 2B, 4B, 6B y 8B",
				"Carboncillo natural y comprimido",
				"Papel de algodón 180 g/m²",
				"Tinta china y plumillas",
				"Goma moldeable y difuminos",
			],
		},
		{
			slug: "pintura-al-oleo",
			titulo: "Pintura al Óleo",
			nivel: "Intermedio",
			duracion: "16 semanas · 1 sesión/semana",
			horarios: "Martes 16:00–20:00 · Jueves 10:00–14:00",
			modalidad: "Presencial · caballete individual",
			docente: "Mtra. Elena Ríos Kanzaki",
			docenteBio:
				"Pintora formada en La Esmeralda con residencias en Tokio. Cree que el óleo es el medio donde la paciencia se vuelve luz.",
			descripcion:
				"El óleo es el medio de los que piensan despacio. Sobre los fundamentos del dibujo, este curso despliega el lenguaje del color: veladuras, empastes, mezclas ópticas y el trabajo por capas que da a la pintura su profundidad silenciosa. Cada alumno termina el curso con una obra completa resuelta con criterio propio.",
			imagen:
				"https://placehold.co/1200x800/EFE6D4/11110E?text=Pintura+al+Oleo",
			queAprenderas: [
				"Preparación de soportes y paleta personal",
				"Teoría del color aplicada: valor, temperatura y saturación",
				"Veladuras, empastes y texturas",
				"Construcción por capas: del boceto a la obra terminada",
				"Lectura crítica de la propia pintura",
			],
			materiales: [
				"Óleos básicos: blanco titanio, amarillo cadmio, rojo cadmio, azul ultramar, sombra tostada",
				"Lienzo preparado 40×50 cm o mayor",
				"Pinceles de cerda y pelo suave",
				"Aceite de linaza y medium",
				"Espátulas y trapo de algodón",
			],
		},
		{
			slug: "acuarela",
			titulo: "Acuarela",
			nivel: "Principiante",
			duracion: "10 semanas · 1 sesión/semana",
			horarios: "Miércoles 10:00–13:00 · Sábados 12:00–15:00",
			modalidad: "Presencial · mesa de agua",
			docente: "Mtro. Hiroshi Tanaka Mendoza",
			docenteBio:
				"Acuarelista de tradición japonesa, veinte años pintando lo que el agua decide y lo que la mano retiene.",
			descripcion:
				"La acuarela es la técnica del equilibrio: entre el control del pincel y el azar del agua. Este curso enseña el oficio húmedo sobre húmedo, el valor del blanco del papel y la economía del gesto que define la estética zen — pocas pinceladas, máxima expresión.",
			imagen: "https://placehold.co/1200x800/EDE3D0/11110E?text=Acuarela",
			queAprenderas: [
				"Técnicas húmedo sobre húmedo y húmedo sobre seco",
				"Reservas, degradados y veladuras transparentes",
				"El blanco del papel como valor activo",
				"Economía del gesto: menos trazos, más expresión",
				"Paisaje, botánica y figura ligera",
			],
			materiales: [
				"Acuarelas en pastilla (set de 12 o más)",
				"Papel de algodón 300 g/m² grano fino",
				"Pinceles redondos de marta sintética núm. 4, 8 y 12",
				"Paleta de cerámica o plástico con pozos",
				"Dos recipientes de agua y esponja natural",
			],
		},
		{
			slug: "grabado-experimental",
			titulo: "Grabado Experimental",
			nivel: "Avanzado",
			duracion: "14 semanas · 1 sesión/semana",
			horarios: "Jueves 17:00–21:00",
			modalidad: "Presencial · tórculo del taller",
			docente: "Mtro. Julián Ordaz Vela",
			docenteBio:
				"Grabador con maestría en gráfica por la UNAM y miembro de un taller colectivo. Entiende la estampa como laboratorio, no como copia.",
			descripcion:
				"La estampa es la imagen que acepta multiplicarse sin repetirse. Este curso explora linóleo, punta seca y monotipia como un laboratorio de riesgo controlado: estado de la plancha, entintado, registro y edición. Para quienes ya dibujan y quieren que su línea encuentre otra piel.",
			imagen:
				"https://placehold.co/1200x800/E2E8DF/11110E?text=Grabado+Experimental",
			queAprenderas: [
				"Linóleo: corte, gubias y estampado manual",
				"Punta seca y entintado en hueco",
				"Monotipia y técnicas de un solo ejemplar",
				"Registro, edición y numeración de obra gráfica",
				"Papeles, tintas y secado profesional",
			],
			materiales: [
				"Juego de gubias para linóleo",
				"Planchas de linóleo y acetato para punta seca",
				"Tintas de grabado al agua o base solvente",
				"Papel guarro y japonés",
				"Rodillo de entintado y cuchara de estampar",
			],
		},
		{
			slug: "caligrafia-oriental",
			titulo: "Caligrafía Oriental",
			nivel: "Intermedio",
			duracion: "8 semanas · 1 sesión/semana",
			horarios: "Viernes 10:00–13:00",
			modalidad: "Presencial · salón de silencio",
			docente: "Profr. José Guadalupe Cabrera",
			docenteBio:
				"Fundador de ArteMichiko, formado en China bajo influencia taoísta. Para él, la caligrafía es meditación con tinta.",
			descripcion:
				"Cada trazo de la caligrafía Oriental es una respiración que queda escrita. Este curso enseña el manejo del pincel de bambú, el orden de los trazos y la estética del vacío — el ma entre forma y forma — sobre papel de arroz. No se escribe con la mano: se escribe con el centro del cuerpo.",
			imagen:
				"https://placehold.co/1200x800/11110E/D4AF37?text=Caligrafia+Oriental",
			queAprenderas: [
				"Sujeción y presión del pincel de bambú",
				"Los ocho trazos fundamentales del carácter",
				"Orden estructural y ritmo de la escritura",
				"La estética del vacío: composición sobre papel de arroz",
				"Ejercicios de respiración aplicados al trazo",
			],
			materiales: [
				"Pincel de caligrafía mediano (pelo de cabra y lobo)",
				"Tinta en barra y piedra de moler",
				"Papel de arroz semitranslúcido",
				"Fieltro de escritorio y pisapapeles",
			],
		},
		{
			slug: "tecnica-interna",
			titulo: "Técnica Interna",
			nivel: "Avanzado",
			duracion: "20 semanas · 2 sesiones/semana",
			horarios: "Lunes 17:00–20:00 · Jueves 10:00–13:00",
			modalidad: "Presencial · admisión por entrevista",
			docente: "Profr. José Guadalupe Cabrera",
			docenteBio:
				"Creador del sistema de Técnica Interna, síntesis de su formación en China y de 35 años de docencia en México.",
			descripcion:
				"El programa insignia de la academia y el único sistema de su tipo en México. La Técnica Interna no parte de la copia sino de la revelación: cultiva en el alumno la capacidad de ver su propio talento y de expresarlo con oficio. Es el curso donde convergen dibujo, pintura y el trabajo interior — la síntesis de la influencia taoísta que dio origen a ArteMichiko.",
			imagen:
				"https://placehold.co/1200x800/F5F0E6/11110E?text=Tecnica+Interna",
			queAprenderas: [
				"El método de revelación de talento propio de la academia",
				"Integración de dibujo, color y composición como una sola práctica",
				"Trabajo interior: atención, respiración y presencia en el trazo",
				"Desarrollo de una serie personal completa",
				"Crítica de taller y lectura de la obra propia",
			],
			materiales: [
				"Cuaderno de obra tamaño oficio",
				"Materiales completos de dibujo y pintura (según avance)",
				"Tinta china y pincel de caligrafía",
				"Compromiso de asistencia puntual",
			],
		},
	];

	return cursos.map((curso, index) => ({
		params: { slug: curso.slug },
		props: { curso, index },
	}));
}

const { curso, index } = Astro.props as { curso: Curso; index: number };

const numeroCurso = String(index + 1).padStart(2, "0");
const whatsappUrl = `https://wa.me/5215512595906?text=${encodeURIComponent(
	`Hola ArteMichiko, quiero inscribirme al curso ${curso.titulo}`,
)}`;
---

<Layout title={curso.titulo} description={`${curso.titulo} — ${curso.descripcion.slice(0, 140)}`}>

  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("anim-ready");
    }
  </script>

  <!-- ═══════ HERO DEL CURSO — text reveal + datos maestros ═══════ -->
  <section data-hero class="relative overflow-hidden pt-40 pb-16 md:pt-48 md:pb-20">
    <div class="grain absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="ink-wash absolute inset-0 pointer-events-none opacity-40" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6">
      <a href="/cursos" data-cursor class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.25em] text-jade-profundo uppercase transition-colors hover:text-jade-tinta">
        <span aria-hidden="true">←</span> Todos los cursos
      </a>

      <div class="mt-10 flex flex-wrap items-baseline justify-between gap-6">
        <h1 class="max-w-3xl font-display text-5xl leading-[1.02] font-semibold tracking-tight md:text-7xl">
          <span class="reveal-line block overflow-hidden"><span class="reveal-inline inline-block">{curso.titulo}</span></span>
        </h1>
        <p class="fade-up font-mono text-2xl text-jade-profundo">{numeroCurso}</p>
      </div>

      <p class="fade-up mt-8 max-w-2xl text-lg leading-relaxed text-tinta-grafito md:text-xl">
        {curso.descripcion}
      </p>

      <!-- Datos maestros -->
      <dl class="fade-up mt-12 grid max-w-4xl grid-cols-2 gap-px border border-tinta-negra/10 bg-tinta-negra/10 md:grid-cols-4">
        <div class="bg-lienzo-blanco p-5">
          <dt class="font-mono text-[11px] tracking-[0.25em] text-tinta-humo uppercase">Nivel</dt>
          <dd class="mt-2 font-medium">{curso.nivel}</dd>
        </div>
        <div class="bg-lienzo-blanco p-5">
          <dt class="font-mono text-[11px] tracking-[0.25em] text-tinta-humo uppercase">Duración</dt>
          <dd class="mt-2 font-medium">{curso.duracion}</dd>
        </div>
        <div class="bg-lienzo-blanco p-5">
          <dt class="font-mono text-[11px] tracking-[0.25em] text-tinta-humo uppercase">Horarios</dt>
          <dd class="mt-2 font-medium">{curso.horarios}</dd>
        </div>
        <div class="bg-lienzo-blanco p-5">
          <dt class="font-mono text-[11px] tracking-[0.25em] text-tinta-humo uppercase">Modalidad</dt>
          <dd class="mt-2 font-medium">{curso.modalidad}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ═══════ IMAGEN DEL CURSO — mask reveal + parallax interno ═══════ -->
  <section class="mx-auto max-w-7xl px-6">
    <figure class="mask-frame relative aspect-[16/9] overflow-hidden rounded-sm md:aspect-[21/9]" data-mask>
      <img
        src={curso.imagen}
        alt={`Taller de ${curso.titulo} — lugar para imagen real`}
        width="1200"
        height="800"
        class="mask-img h-full w-full object-cover"
      />
      <figcaption class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-tinta-negra/70 to-transparent p-6 font-mono text-xs tracking-[0.2em] text-lienzo-hueso uppercase">
        {curso.titulo} · Taller ArteMichiko
      </figcaption>
    </figure>
  </section>

  <!-- ═══════ QUÉ APRENDERÁS + MATERIALES ═══════ -->
  <section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Programa</p>
        <h2 class="fade-up mt-4 font-display text-4xl font-semibold tracking-tight md:text-5xl">
          Qué <span class="text-oro-brillo">aprenderás</span>
        </h2>
        <ol class="mt-10 space-y-6">
          {curso.queAprenderas.map((item, i) => (
            <li class="fade-up group flex gap-5 border-b border-tinta-negra/10 pb-6 transition-colors hover:border-jade-base">
              <span class="font-mono text-sm text-jade-profundo">0{i + 1}</span>
              <p class="leading-relaxed text-tinta-grafito transition-colors group-hover:text-tinta-negra">{item}</p>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Lo que necesitas</p>
        <h2 class="fade-up mt-4 font-display text-4xl font-semibold tracking-tight md:text-5xl">
          Materiales <span class="text-oro-brillo">del taller</span>
        </h2>
        <ul class="mt-10 space-y-4">
          {curso.materiales.map((item) => (
            <li class="fade-up flex items-baseline gap-4">
              <span class="h-1.5 w-1.5 shrink-0 translate-y-[-1px] bg-oro-brillo" aria-hidden="true"></span>
              <p class="leading-relaxed text-tinta-grafito">{item}</p>
            </li>
          ))}
        </ul>

        <!-- Docente -->
        <div class="fade-up mt-14 rounded-sm border border-tinta-negra/10 bg-lienzo-hueso/50 p-8 transition-colors duration-500 hover:border-jade-base">
          <p class="font-mono text-xs tracking-[0.3em] text-jade-profundo uppercase">Imparte</p>
          <h3 class="mt-3 font-display text-2xl font-semibold">{curso.docente}</h3>
          <p class="mt-3 leading-relaxed text-tinta-grafito">{curso.docenteBio}</p>
          <a href="/docentes" data-cursor class="mt-6 inline-block border-b border-oro-brillo pb-1 text-sm font-medium transition-colors hover:border-jade-base hover:text-jade-profundo">
            Conocer a los maestros <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ CTA GRANDE → WhatsApp pre-llenado del curso ═══════ -->
  <section class="relative overflow-hidden bg-tinta-negra text-lienzo-blanco">
    <div class="grain absolute inset-0 pointer-events-none opacity-20" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
      <p class="fade-up font-mono text-xs tracking-[0.3em] text-jade-claro uppercase">Cupo limitado</p>
      <h2 class="fade-up mt-6 font-display text-4xl font-semibold tracking-tight md:text-6xl">
        Tu lugar en <span class="bg-gradient-to-r from-oro-viejo via-oro-brillo to-oro-arena bg-clip-text text-transparent">{curso.titulo}</span>
      </h2>
      <p class="fade-up mx-auto mt-6 max-w-xl leading-relaxed text-lienzo-hueso/70">
        Escríbenos y una persona del equipo te confirma disponibilidad, costo y fecha de inicio. Sin formularios largos: conversación directa.
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        data-cursor
        class="fade-up mt-10 inline-flex items-center gap-3 rounded-full bg-oro-brillo px-10 py-4 font-medium text-tinta-negra shadow-[0_8px_40px_rgba(212,175,55,0.35)] transition-all hover:scale-105 hover:bg-oro-viejo"
      >
        <span class="text-lg" aria-hidden="true">✆</span>
        Inscribirme por WhatsApp
      </a>
      <p class="fade-up mt-6 font-mono text-xs text-lienzo-hueso/50">
        {curso.horarios} · {curso.modalidad}
      </p>
    </div>
  </section>
</Layout>

<style>
  .grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .ink-wash {
    background:
      radial-gradient(ellipse 60% 40% at 15% 20%, rgba(0, 166, 107, 0.08), transparent 70%),
      radial-gradient(ellipse 50% 35% at 85% 75%, rgba(212, 175, 55, 0.06), transparent 70%),
      radial-gradient(ellipse 40% 30% at 70% 15%, rgba(17, 17, 14, 0.04), transparent 60%);
  }

  .reveal-inline { will-change: transform; }

  .mask-frame { position: relative; }
  .mask-img {
    will-change: transform;
    transform: scale(1.12);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mask-frame:hover .mask-img { transform: scale(1.05); }

  .anim-ready .reveal-inline { transform: translateY(110%); }
  .anim-ready [data-hero] .fade-up { opacity: 0; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReduced) {
    // ── 1. HERO: reveal del título + fade-ups sobre el pliegue ──
    gsap.to(".reveal-inline", { y: "0%", duration: 1.1, ease: "power4.out", delay: 0.15 });
    gsap.fromTo(
      "[data-hero] .fade-up",
      { opacity: 0, y: 32 },
      { opacity: 1, y: 0, duration: 1, ease: "expo.out", stagger: 0.12, delay: 0.5 }
    );

    // ── 2. Fade-ups bajo el pliegue ──
    const fadeUps = gsap.utils.toArray<HTMLElement>(".fade-up").filter((el) => !el.closest("[data-hero]"));
    fadeUps.forEach((el) => {
      gsap.fromTo(el, { opacity: 0, y: 32 }, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "expo.out",
        scrollTrigger: { trigger: el, start: "top 88%" },
      });
    });

    // ── 3. MASK REVEAL + parallax interno de la imagen del curso ──
    gsap.utils.toArray<HTMLElement>("[data-mask]").forEach((frame) => {
      const img = frame.querySelector(".mask-img");
      if (!img) return;
      gsap.fromTo(
        frame,
        { clipPath: "inset(100% 0 0 0)" },
        {
          clipPath: "inset(0% 0 0 0)",
          duration: 1.2,
          ease: "power4.out",
          scrollTrigger: { trigger: frame, start: "top 85%" },
        }
      );
      gsap.to(img, {
        yPercent: -10,
        ease: "none",
        scrollTrigger: { trigger: frame, scrub: 0.6 },
      });
    });
  }
</script>
