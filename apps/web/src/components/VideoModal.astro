---
// ArteMichiko — VideoModal: lightbox de video (75-80% pantalla, fondo oscuro)
// Uso: <VideoModal id="video-canal11" videoId="KsFEtwfALnQ" title="..." />
// Se invoca con un botón [data-open-modal="<id>"] y se cierra con X / clic en fondo / Esc
interface Props {
	id: string;
	videoId: string;
	title: string;
	label?: string;
}
const { id, videoId, title, label = "Ver video" } = Astro.props;
---

<button
  type="button"
  data-open-modal={id}
  data-cursor
  class="group inline-flex items-center gap-3 rounded-full border border-tinta-negra px-7 py-3 font-medium transition-all hover:border-oro-brillo hover:text-oro-viejo"
>
  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-tinta-negra text-lienzo-blanco transition-colors group-hover:bg-oro-brillo group-hover:text-tinta-negra" aria-hidden="true">▶</span>
  {label}
</button>

<div
  id={id}
  class="video-modal fixed inset-0 z-[9990] isolate hidden items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label={title}
>
  <!-- Fondo oscuro (z-0) -->
  <div class="video-modal-backdrop absolute inset-0 z-0 bg-tinta-negra/90 backdrop-blur-md" data-close-modal={id}></div>

  <!-- Contenedor del video (z-10, 75-80% de la pantalla) -->
  <div class="video-modal-box relative z-10 w-[85vw] max-w-6xl lg:w-[78vw]" data-video-id={videoId}>
    <div class="relative aspect-video overflow-hidden rounded-lg border border-oro-brillo/30 bg-black shadow-[0_40px_120px_rgba(0,0,0,0.8)]">
      <!-- Placeholder: se REMUEVE del DOM al montar el iframe (evita el encimado) -->
      <div id={`${id}-placeholder`} class="absolute inset-0">
        <img
          src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`}
          alt={title}
          class="h-full w-full object-cover"
          loading="lazy"
          width="1280"
          height="720"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" aria-hidden="true"></div>
      </div>
    </div>
    <p class="mt-4 text-center font-mono text-xs tracking-widest text-lienzo-hueso/70 uppercase">{title}</p>
  </div>

  <!-- Botón cerrar (z-20, por encima de todo) -->
  <button
    type="button"
    data-close-modal={id}
    aria-label="Cerrar video"
    class="absolute top-6 right-6 z-20 flex h-12 w-12 items-center justify-center rounded-full border border-lienzo-blanco/20 text-lienzo-blanco transition-all hover:rotate-90 hover:border-oro-brillo hover:text-oro-brillo focus:outline-none focus-visible:ring-2 focus-visible:ring-oro-brillo"
  >
    ✕
  </button>
</div>

<style>
  .video-modal.open {
    display: flex;
  }
  /* Animación de entrada: scale + fade */
  .video-modal-box {
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .video-modal.open .video-modal-box {
    opacity: 1;
    transform: scale(1);
  }
  .video-modal-backdrop {
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .video-modal.open .video-modal-backdrop {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-modal-box,
    .video-modal-backdrop {
      transition: none;
    }
  }
</style>

<script>
  // ── Utilidades de apertura/cierre ──
  const triggerByModal = new WeakMap<HTMLElement, HTMLElement>();

  function openVideoModal(modal: HTMLElement) {
    modal.classList.add("open");
    document.body.style.overflow = "hidden";

    const box = modal.querySelector<HTMLElement>(".video-modal-box");
    const videoId = box?.dataset.videoId;
    const shell = box?.querySelector<HTMLElement>(".aspect-video");
    if (!box || !videoId || !shell) return;

    // 1) Montar iframe solo la primera vez (autoplay al abrir)
    if (!modal.querySelector("iframe")) {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = modal.getAttribute("aria-label") ?? "";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      shell.appendChild(iframe);
    }

    // 2) REMOVER el placeholder del DOM: la miniatura maxresdefault no debe
    //    quedar detrás del iframe (causaba el video "encimado")
    modal.querySelector<HTMLElement>(`#${modal.id}-placeholder`)?.remove();

    // 3) Foco al botón cerrar (a11y)
    modal.querySelector<HTMLElement>("[data-close-modal]")?.focus({ preventScroll: true });
  }

  function closeVideoModal(modal: HTMLElement) {
    modal.classList.remove("open");
    document.body.style.overflow = "";

    // Pausar sin desmontar: sin audio de fondo, y al reabrir NO se duplica
    // (el iframe ya existe y el placeholder ya fue removido)
    const iframe = modal.querySelector<HTMLIFrameElement>("iframe");
    if (iframe?.contentWindow) {
      try {
        iframe.contentWindow.postMessage(
          JSON.stringify({ event: "command", func: "pauseVideo", args: [] }),
          "*"
        );
      } catch {
        /* sin API de YouTube disponible, ignorar */
      }
    }

    const trigger = triggerByModal.get(modal);
    trigger?.focus({ preventScroll: true });
  }

  // ── Triggers de apertura (botón con [data-open-modal]) ──
  document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((trigger) => {
    if (trigger.dataset.modalBound) return;
    trigger.dataset.modalBound = "1";
    trigger.addEventListener("click", () => {
      const modal = document.getElementById(trigger.dataset.openModal ?? "");
      if (!modal) return;
      triggerByModal.set(modal, trigger);
      openVideoModal(modal);
    });
  });

  // ── Cierre: botón X y clic en el fondo ──
  document.querySelectorAll<HTMLElement>("[data-close-modal]").forEach((closer) => {
    if (closer.dataset.modalBound) return;
    closer.dataset.modalBound = "1";
    closer.addEventListener("click", () => {
      const modal = document.getElementById(closer.dataset.closeModal ?? "");
      if (modal) closeVideoModal(modal);
    });
  });

  // ── Cierre con Esc (listener global, una sola vez) ──
  const escFlag = "__artemichikoVideoModalEsc";
  if (!(window as unknown as Record<string, unknown>)[escFlag]) {
    (window as unknown as Record<string, unknown>)[escFlag] = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = document.querySelector<HTMLElement>(".video-modal.open");
      if (open) closeVideoModal(open);
    });
  }
</script>
