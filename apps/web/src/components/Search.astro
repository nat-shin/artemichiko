---
// ArteMichiko — Búsqueda interna con Pagefind (obras/cursos/blog, sin backend)
// La UI sigue la identidad Barro y Tinta: lienzo, tinta, jade, oro.
// En `astro dev` el índice /pagefind/ no existe: la sonda available() del
// cliente detecta ese caso y el buscador muestra un fallback elegante con
// sugerencias clicables en vez de "no disponible".
---

<div class="search-widget">
  <button
    type="button"
    class="search-trigger"
    data-open-search
    aria-label="Buscar en el sitio"
    aria-haspopup="dialog"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <line x1="16.5" y1="16.5" x2="21" y2="21" />
    </svg>
  </button>

  <div class="search-overlay" data-search-overlay role="dialog" aria-modal="true" aria-label="Búsqueda">
    <div class="search-backdrop" data-close-search></div>
    <div class="search-panel" data-search-panel>
      <div class="search-panel-head">
        <svg class="search-head-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
        <input
          type="search"
          class="search-input"
          data-search-input
          placeholder="Buscar obras, cursos, técnicas…"
          aria-label="Buscar obras, cursos, técnicas"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="search-clear" data-search-clear aria-label="Limpiar búsqueda" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
        <button type="button" class="search-close" data-close-search aria-label="Cerrar búsqueda">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>

      <div class="search-body" data-search-body>
        <div class="search-status" data-search-status aria-live="polite"></div>
        <div id="search-results-list" class="search-results" data-search-results role="listbox" aria-label="Resultados de búsqueda"></div>
        <div class="search-idle" data-search-idle></div>
      </div>

      <footer class="search-footer">
        <span class="search-footer-hints">
          <kbd>↑</kbd><kbd>↓</kbd> navegar · <kbd>Enter</kbd> abrir · <kbd>Esc</kbd> cerrar
        </span>
        <span class="search-footer-brand" aria-hidden="true">ArteMichiko</span>
      </footer>
    </div>
  </div>
</div>

<style is:global>
  /* is:global — los resultados se inyectan vía innerHTML y no llevan el
     atributo de scope de Astro ([data-astro-cid]); las clases search-* son
     exclusivas de este componente, así que no hay riesgo de colisión. */
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 1px solid rgba(17, 17, 14, 0.15);
    background: transparent;
    color: var(--color-tinta-negra);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .search-trigger:hover {
    border-color: var(--color-jade-profundo);
    color: var(--color-jade-profundo);
    transform: translateY(-1px);
  }
  .search-trigger:focus-visible {
    outline: 2px solid var(--color-jade-profundo);
    outline-offset: 2px;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9990;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 5vw 5vh;
  }
  .search-overlay.open { display: flex; }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 120% at 50% 0%, rgba(28, 24, 18, 0.62), rgba(17, 17, 14, 0.8));
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .search-overlay.open .search-backdrop { opacity: 1; }

  .search-panel {
    position: relative;
    z-index: 1;
    width: min(680px, 100%);
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 700px);
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    background: rgba(253, 251, 247, 0.88);
    backdrop-filter: blur(28px) saturate(1.35);
    box-shadow:
      0 2px 6px rgba(17, 17, 14, 0.1),
      0 24px 80px rgba(17, 17, 14, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    transform: translateY(-10px) scale(0.985);
    opacity: 0;
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }
  .search-panel::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-oro-brillo), transparent);
    opacity: 0.55;
    pointer-events: none;
  }
  .search-overlay.open .search-panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .search-panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.22);
    color: var(--color-tinta-grafito);
  }
  .search-head-icon {
    flex-shrink: 0;
    color: var(--color-oro-viejo);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: 1.1rem;
    color: var(--color-tinta-negra);
  }
  .search-input::placeholder { color: var(--color-tinta-humo); }

  .search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    border: none;
    background: rgba(17, 17, 14, 0.06);
    color: var(--color-tinta-grafito);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .search-clear:hover {
    background: rgba(17, 17, 14, 0.12);
    color: var(--color-tinta-negra);
  }
  .search-clear[hidden] { display: none; }

  .search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-tinta-grafito);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .search-close:hover {
    background: rgba(17, 17, 14, 0.06);
    color: var(--color-tinta-negra);
  }

  .search-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 0 12px;
  }

  .search-status {
    min-height: 26px;
    padding: 8px 22px 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-tinta-humo);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .search-status:not(:empty) { opacity: 1; }
  .search-status.loading { color: var(--color-jade-profundo); }
  .search-status.loading::after {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--color-jade-base);
    animation: search-dot-pulse 1s ease-in-out infinite;
  }
  @keyframes search-dot-pulse {
    0%, 100% { opacity: 0.25; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1); }
  }

  .search-results { padding: 4px 0; }
  .search-results:empty { display: none; }

  .search-result-item {
    display: block;
    position: relative;
    padding: 14px 22px;
    text-decoration: none;
    color: var(--color-tinta-negra);
    border-left: 2px solid transparent;
    animation: search-item-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .search-result-item::after {
    content: "→";
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-oro-viejo);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .search-result-item:hover::after,
  .search-result-item.active::after {
    opacity: 1;
    transform: translateY(-50%) translateX(2px);
  }
  .search-result-item:hover {
    background: linear-gradient(90deg, rgba(0, 166, 107, 0.07), transparent 75%);
    border-left-color: var(--color-jade-base);
  }
  .search-result-item.active {
    background: linear-gradient(90deg, rgba(0, 166, 107, 0.12), transparent 75%);
    border-left-color: var(--color-jade-profundo);
  }
  .search-result-item.active .search-result-title { color: var(--color-jade-tinta); }
  .search-result-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 4px;
    padding-right: 18px;
  }
  .search-result-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-tinta-humo);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 6px;
  }
  .search-result-excerpt {
    display: block;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-tinta-grafito);
    line-height: 1.55;
  }
  .search-hit,
  .search-result-excerpt mark {
    background: linear-gradient(to top, rgba(212, 175, 55, 0.34) 0 42%, transparent 42%);
    color: inherit;
    padding: 0 1px;
    border-radius: 2px;
  }

  .search-idle { padding: 4px 0; }
  .search-idle:empty { display: none; }

  .search-state {
    padding: 12px 22px 16px;
  }
  .search-state-title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-tinta-negra);
  }
  .search-state-note {
    margin: 0 0 14px;
    font-size: 0.875rem;
    color: var(--color-tinta-grafito);
    line-height: 1.5;
  }
  .search-state-fallback .search-state-note { margin-bottom: 16px; }

  .search-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid rgba(212, 175, 55, 0.28);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    color: var(--color-tinta-negra);
    animation: search-item-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .search-chip:hover {
    border-color: var(--color-jade-base);
    background: rgba(0, 166, 107, 0.06);
    transform: translateY(-1px);
  }
  .search-chip.active {
    border-color: var(--color-jade-profundo);
    background: rgba(0, 166, 107, 0.1);
    box-shadow: 0 0 0 3px rgba(0, 166, 107, 0.14);
  }
  .search-chip-label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .search-chip-hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-tinta-humo);
  }

  @keyframes search-item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Stagger de entrada — clases (no inline styles: la CSP del sitio bloquea
     los style="..." dinámicos, así que el delay vive en la hoja de estilos) */
  .stagger-0 { animation-delay: 0ms; }
  .stagger-1 { animation-delay: 45ms; }
  .stagger-2 { animation-delay: 90ms; }
  .stagger-3 { animation-delay: 135ms; }
  .stagger-4 { animation-delay: 180ms; }
  .stagger-5 { animation-delay: 225ms; }
  .stagger-6 { animation-delay: 270ms; }
  .stagger-7 { animation-delay: 315ms; }
  .stagger-8 { animation-delay: 360ms; }
  .stagger-9 { animation-delay: 405ms; }

  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px;
    border-top: 1px solid rgba(17, 17, 14, 0.08);
    background: rgba(245, 240, 230, 0.55);
    font-size: 0.72rem;
    color: var(--color-tinta-humo);
  }
  .search-footer-hints {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-footer-hints kbd {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1;
    padding: 3px 6px;
    border: 1px solid rgba(17, 17, 14, 0.16);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.6);
    color: var(--color-tinta-grafito);
  }
  .search-footer-brand {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-oro-viejo);
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding: 0;
      align-items: stretch;
    }
    .search-panel {
      width: 100%;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      border: none;
      transform: translateY(14px);
    }
    .search-overlay.open .search-panel { transform: none; }
    .search-body { padding-bottom: 8px; }
    .search-footer-brand { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-panel,
    .search-backdrop {
      transition: none;
    }
    .search-result-item,
    .search-chip {
      animation: none;
    }
    .search-status.loading::after {
      animation: none;
    }
  }
</style>

<script>
  // Pagefind: se carga lazy al abrir el buscador (no penaliza CWV).
  // El cliente real vive en /pagefind-client.js (módulo externo ESM, CSP-safe —
  // usa import() nativo, sin eval). En `astro dev` el índice /pagefind/ NO
  // existe (solo `astro build` lo genera): la sonda available() del cliente
  // detecta ese caso y aquí se muestra un fallback elegante con sugerencias.
  type Suggestion = { label: string; href: string; hint: string };

  const SUGGESTIONS: Suggestion[] = [
    { label: "Galería", href: "/galeria", hint: "obras" },
    { label: "Cursos", href: "/cursos", hint: "programas" },
    { label: "Revista", href: "/blog", hint: "lecturas" },
    { label: "Inscripciones", href: "/inscripcion", hint: "matrícula" },
    { label: "Docentes", href: "/docentes", hint: "equipo" },
    { label: "Nosotros", href: "/nosotros", hint: "historia" },
    { label: "Preguntas", href: "/faq", hint: "ayuda" },
  ];

  let searchReady = false;
  let requestId = 0;
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let activeIndex = -1;
  let navItems: HTMLElement[] = [];
  let lastFocus: Element | null = null;

  const overlay = document.querySelector("[data-search-overlay]") as HTMLElement | null;
  const panel = document.querySelector("[data-search-panel]") as HTMLElement | null;
  const input = document.querySelector("[data-search-input]") as HTMLInputElement | null;
  const resultsEl = document.querySelector("[data-search-results]") as HTMLElement | null;
  const idleEl = document.querySelector("[data-search-idle]") as HTMLElement | null;
  const statusEl = document.querySelector("[data-search-status]") as HTMLElement | null;
  const clearBtn = document.querySelector("[data-search-clear]") as HTMLButtonElement | null;

  const boot = (): void => {
    if (!overlay || !panel || !input || !resultsEl || !idleEl || !statusEl || !clearBtn) return;

  function loadSearchClient(): Promise<void> {
    return new Promise((resolve) => {
      if (searchReady) return resolve();
      searchReady = true;
      const script = document.createElement("script");
      script.src = "/pagefind-client.js";
      script.type = "module";
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => {
        console.warn("Buscador no disponible");
        resolve();
      };
      document.head.appendChild(script);
    });
  }

  async function ensureSearchApi(): Promise<any> {
    const w = window as any;
    let api = w.__artemichikoSearch;
    if (!api?.search) {
      await loadSearchClient();
      api = w.__artemichikoSearch;
    }
    return api?.search ? api : null;
  }

  function escapeHTML(text: string): string {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function highlight(text: string, query: string): string {
    const terms = query.trim().split(/\s+/).filter((t) => t.length >= 2);
    let out = escapeHTML(text);
    for (const t of terms) {
      const needle = escapeHTML(t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
      try {
        out = out.replace(new RegExp(needle, "gi"), (m) => `<mark class="search-hit">${m}</mark>`);
      } catch {
        /* regex inválido — se omite el highlight de ese término */
      }
    }
    return out;
  }

  // El excerpt de Pagefind llega como HTML con <mark> propio; se sanea
  // dejando solo esa marca (nunca se ejecuta script en un nodo desmontado).
  function sanitizeExcerpt(html: string): string {
    const doc = document.createElement("div");
    doc.innerHTML = html;
    doc.querySelectorAll("*").forEach((el) => {
      if (el.tagName.toLowerCase() !== "mark") {
        el.replaceWith(...Array.from(el.childNodes));
      }
    });
    return doc.innerHTML;
  }

  function chipsHTML(): string {
    return `<div class="search-suggestions">${SUGGESTIONS.map(
      (s, i) => `
        <a class="search-chip stagger-${Math.min(i, 9)}" data-search-nav href="${s.href}">
          <span class="search-chip-label">${s.label}</span>
          <span class="search-chip-hint">${s.hint}</span>
        </a>`
    ).join("")}</div>`;
  }

  function setStatus(text: string, loading = false) {
    statusEl!.textContent = text;
    statusEl!.classList.toggle("loading", loading);
  }

  function setActive(index: number) {
    navItems = Array.from(panel!.querySelectorAll<HTMLElement>("[data-search-nav]"));
    if (navItems.length === 0) {
      activeIndex = -1;
      return;
    }
    activeIndex = ((index % navItems.length) + navItems.length) % navItems.length;
    navItems.forEach((el, i) => {
      const isActive = i === activeIndex;
      el.classList.toggle("active", isActive);
      if (isActive) {
        if (el.getAttribute("role") === "option") {
          el.setAttribute("aria-selected", "true");
          input!.setAttribute("aria-activedescendant", el.id);
        }
        el.scrollIntoView({ block: "nearest" });
      } else {
        el.removeAttribute("aria-selected");
      }
    });
  }

  function renderIdle() {
    resultsEl!.innerHTML = "";
    idleEl!.innerHTML = `
      <div class="search-state">
        <p class="search-state-title">Sugerencias para comenzar</p>
        ${chipsHTML()}
      </div>`;
    setStatus("");
    setActive(0);
  }

  function renderFallback(term: string) {
    resultsEl!.innerHTML = "";
    idleEl!.innerHTML = `
      <div class="search-state search-state-fallback">
        <p class="search-state-title">La búsqueda completa aún no está disponible aquí</p>
        <p class="search-state-note">La búsqueda completa está disponible en el sitio publicado. Mientras tanto, explora:</p>
        ${chipsHTML()}
      </div>`;
    setStatus(term.trim() ? `sin índice de búsqueda en este entorno` : "");
    setActive(0);
  }

  function renderNoResults(term: string) {
    resultsEl!.innerHTML = "";
    idleEl!.innerHTML = `
      <div class="search-state">
        <p class="search-state-title">Sin resultados para «${escapeHTML(term.trim())}»</p>
        <p class="search-state-note">Prueba con otra palabra o explora una sección:</p>
        ${chipsHTML()}
      </div>`;
    setStatus("0 resultados");
    setActive(0);
  }

  function renderResults(items: any[], total: number, term: string) {
    const shown = items.length;
    setStatus(
      total > shown
        ? `mostrando ${shown} de ${total} resultados`
        : total === 1
          ? "1 resultado"
          : `${total} resultados`
    );
    resultsEl!.innerHTML = items
      .map(
        (d: any, i: number) => `
        <a id="search-opt-${i}" class="search-result-item stagger-${Math.min(i, 9)}" role="option" data-search-nav
           href="${escapeHTML(d.url ?? "#")}">
          <span class="search-result-title">${highlight(d.meta?.title ?? "Sin título", term)}</span>
          <span class="search-result-meta">${escapeHTML(d.meta?.breadcrumb ?? "ArteMichiko")}</span>
          ${d.excerpt ? `<span class="search-result-excerpt">${sanitizeExcerpt(d.excerpt)}</span>` : ""}
        </a>`
      )
      .join("");
    idleEl!.innerHTML = "";
    setActive(0);
  }

  async function runSearch(term: string) {
    const token = ++requestId;
    const trimmed = term.trim();
    if (trimmed.length < 2) {
      renderIdle();
      return;
    }
    setStatus("Buscando…", true);
    const api = await ensureSearchApi();
    if (token !== requestId) return;
    if (!api) {
      renderFallback(trimmed);
      return;
    }
    let ready = false;
    try {
      ready = await api.available();
    } catch {
      ready = false;
    }
    if (token !== requestId) return;
    if (!ready) {
      renderFallback(trimmed);
      return;
    }
    let searchResult: any;
    try {
      searchResult = await api.search(trimmed);
    } catch {
      if (token !== requestId) return;
      renderFallback(trimmed);
      return;
    }
    if (token !== requestId) return;
    if (searchResult?.unavailable || !searchResult?.results || searchResult.results.length === 0) {
      renderNoResults(trimmed);
      return;
    }
    const items = await Promise.all(searchResult.results.slice(0, 10).map((r: any) => r.data()));
    if (token !== requestId) return;
    renderResults(items, searchResult.results.length, trimmed);
  }

  function openSearch() {
    overlay!.classList.add("open");
    document.body.style.overflow = "hidden";
    input!.setAttribute("aria-expanded", "true");
    lastFocus = document.activeElement;
    if (!idleEl!.innerHTML && !resultsEl!.innerHTML) renderIdle();
    void loadSearchClient();
    setTimeout(() => input!.focus(), 60);
  }

  function closeSearch() {
    overlay!.classList.remove("open");
    document.body.style.overflow = "";
    input!.setAttribute("aria-expanded", "false");
    input!.removeAttribute("aria-activedescendant");
    activeIndex = -1;
    navItems = [];
    (lastFocus as HTMLElement | null)?.focus?.();
  }

  document.querySelectorAll("[data-open-search]").forEach((btn) => {
    btn.addEventListener("click", openSearch);
  });

  document.querySelectorAll("[data-close-search]").forEach((closer) => {
    closer.addEventListener("click", closeSearch);
  });

  clearBtn!.addEventListener("click", () => {
    input!.value = "";
    clearBtn!.hidden = true;
    input!.focus();
    renderIdle();
  });

  input!.addEventListener("input", (e) => {
    const term = (e.target as HTMLInputElement).value;
    clearBtn!.hidden = term.length === 0;
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => void runSearch(term), 150);
  });

  panel!.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === "Enter") {
      if (activeIndex >= 0 && navItems[activeIndex]) {
        e.preventDefault();
        navItems[activeIndex].click();
      }
    } else if (e.key === "Tab") {
      const focusables = Array.from(
        panel!.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || !panel!.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay!.classList.contains("open")) {
      closeSearch();
      return;
    }
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (overlay!.classList.contains("open")) {
        input!.focus();
      } else {
        openSearch();
      }
    }
  });
  };
  boot();
</script>
