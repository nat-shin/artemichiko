---
// ArteMichiko — Layout base (header direction-aware + Lenis + cursor follower)
// Identidad: blanco/negro/dorado/jade (E.35/E.38) · Nivel Awwwards
import "../styles/global.css";
import Search from "../components/Search.astro";
import "@fontsource/shippori-mincho/latin-400.css";
import "@fontsource/shippori-mincho/latin-600.css";
import "@fontsource/shippori-mincho/latin-700.css";
import "@fontsource/zen-old-mincho/latin-400.css";
import "@fontsource/zen-old-mincho/latin-900.css";
import "@fontsource/noto-serif-jp/latin-400.css";
import "@fontsource/noto-serif-jp/latin-700.css";

interface Props {
	title?: string;
	description?: string;
}
const {
	title = "ArteMichiko",
	description = "Centro Cultural Académico de Dibujo y Pintura Artística",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · ArteMichiko</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#11110E" />
    <!--
      PWA manifest + iconos de marca (sello 印) sin service worker.
      Motivo: sitio 100% estático servido por Cloudflare CDN — un SW agregaría
      una capa de caché propia que puede servir HTML obsoleto tras un deploy
      (riesgo clásico de "no se actualiza nunca"), sin beneficio offline real
      para una academia de arte. `display: standalone` del manifest basta para
      instalabilidad en navegadores modernos.
    -->
    <!-- Entidad raíz — EducationalOrganization + sameAs (GEO/Entity SEO, mapa estratégico 2026) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "ArteMichiko — Centro Cultural Académico de Dibujo y Pintura Artística",
        "alternateName": ["ArteMichiko", "Arte Michiko", "Michiko"],
        "description": "Academia de arte con Sistema y Metodología Oriental único en México: grafito, color, tinta y óleo. Fundada por el Mtro. José Guadalupe Cabrera.",
        "url": "https://artemichiko.com",
        "telephone": "+52 55 1259 5906",
        "email": "maestraelviramena@hotmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Revolución 718-101",
          "addressLocality": "San José Insurgentes, Benito Juárez",
          "postalCode": "03910",
          "addressCountry": "MX"
        },
        "founder": {
          "@type": "Person",
          "name": "José Guadalupe Cabrera Cabrera",
          "jobTitle": "Director y Fundador Académico Artístico"
        },
        "sameAs": [
          "https://www.instagram.com/arte_michiko",
          "https://www.facebook.com/centroculturalmichiko",
          "https://www.youtube.com/@centroculturalacademicoded7862",
          "https://www.tiktok.com/@artemichiko"
        ]
      }
    </script>
  </head>
  <body class="bg-lienzo-blanco text-tinta-negra font-sans antialiased">
    <!-- Skip-link a11y (WCAG 2.4.1 Bypass Blocks): visible solo al recibir foco -->
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <!-- Scroll progress (barra dorada de lectura) -->
    <div id="scroll-progress" class="fixed top-0 left-0 z-[9997] h-[2px] w-0 bg-oro-brillo" aria-hidden="true"></div>

    <!-- Back-to-top (aparece tras 600px de scroll) -->
    <button type="button" id="back-to-top" class="back-to-top" aria-label="Volver arriba">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <line x1="12" y1="20" x2="12" y2="4" />
        <polyline points="6,10 12,4 18,10" />
      </svg>
    </button>

    <!-- Grano de película global: textura estática sobre todas las páginas (bajo modal/preloader/cursor) -->
    <div id="grain-overlay" class="grain" aria-hidden="true"></div>

    <!-- Cursor follower (solo pointer:fine, garnish) -->
    <div id="cursor-dot" class="cursor-dot" aria-hidden="true"></div>

    <header id="site-header" class="site-header">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5" aria-label="Principal">
        <a href="/" class="group flex items-center gap-2 font-display text-2xl font-semibold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-sm border-2 border-jade-profundo font-display text-sm text-jade-tinta" aria-hidden="true">印</span>
          Arte<span class="text-oro-brillo">Michiko</span>
        </a>
        <ul class="hidden gap-8 text-sm tracking-wide md:flex">
          <li><a href="/galeria" class="nav-link" data-cursor>Galería</a></li>
          <li><a href="/cursos" class="nav-link" data-cursor>Cursos</a></li>
          <li><a href="/comunidad" class="nav-link" data-cursor>Comunidad</a></li>
          <li><a href="/nosotros" class="nav-link" data-cursor>Nosotros</a></li>
        </ul>
        <div class="flex items-center gap-3">
          <Search />
          <button
            type="button"
            id="menu-abrir"
            class="menu-trigger md:hidden"
            aria-label="Abrir menú"
            aria-controls="menu-movil"
            aria-expanded="false"
            data-cursor
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <a
            href="/inscripcion"
            class="btn-magnetic rounded-full bg-oro-brillo px-5 py-2 text-sm font-medium text-tinta-negra transition-colors hover:bg-oro-viejo"
            data-cursor
          >
            Inscribirme
          </a>
        </div>
      </nav>
    </header>

    <!-- Menú móvil — drawer lateral derecho (solo <md). Overlay: clic fuera cierra. -->
    <div id="menu-overlay" class="menu-overlay" aria-hidden="true"></div>
    <aside
      id="menu-movil"
      class="menu-panel flex flex-col bg-lienzo-blanco"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación"
      inert
    >
      <div class="flex items-center justify-between border-b border-tinta-negra/10 px-6 py-5">
        <p class="font-display text-xl font-semibold tracking-tight">
          Arte<span class="text-oro-brillo">Michiko</span>
        </p>
        <button
          type="button"
          id="menu-cerrar"
          class="menu-close"
          aria-label="Cerrar menú"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>
      <nav class="flex flex-col gap-1 px-6 py-8" aria-label="Secciones">
        <a href="/galeria" class="menu-link" data-cursor>Galería</a>
        <a href="/cursos" class="menu-link" data-cursor>Cursos</a>
        <a href="/comunidad" class="menu-link" data-cursor>Comunidad</a>
        <a href="/nosotros" class="menu-link" data-cursor>Nosotros</a>
      </nav>
      <div class="mt-auto px-6 pb-10">
        <a
          href="/inscripcion"
          class="btn-magnetic block rounded-full bg-oro-brillo px-5 py-3 text-center text-sm font-medium text-tinta-negra transition-colors hover:bg-oro-viejo"
          data-cursor
        >
          Inscribirme
        </a>
      </div>
    </aside>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer mt-24 border-t border-tinta-negra/10 bg-tinta-negra text-lienzo-blanco">
      <div class="footer-inner mx-auto max-w-7xl px-6 py-12">
        <div class="flex flex-col items-start justify-between gap-8 md:flex-row">
          <div>
            <p class="font-display text-xl">Arte<span class="text-oro-brillo">Michiko</span></p>
            <p class="mt-2 max-w-xs text-sm text-lienzo-hueso/70">
              Centro Cultural Académico de Dibujo y Pintura Artística. Sistema Oriental único en México.
            </p>
          </div>
          <div>
            <p class="text-sm font-medium tracking-widest text-oro-brillo uppercase">Visita nuestras redes</p>
            <ul class="mt-3 flex gap-4 text-sm text-lienzo-hueso/80">
              <li><a href="https://www.instagram.com/arte_michiko" target="_blank" rel="noopener" class="hover:text-jade-base transition-colors">Instagram</a></li>
              <li><a href="https://www.facebook.com/centroculturalmichiko" target="_blank" rel="noopener" class="hover:text-jade-base transition-colors">Facebook</a></li>
              <li><a href="https://www.youtube.com/@centroculturalacademicoded7862" target="_blank" rel="noopener" class="hover:text-jade-base transition-colors">YouTube</a></li>
              <li><a href="https://www.tiktok.com" target="_blank" rel="noopener" class="hover:text-jade-base transition-colors">TikTok</a></li>
            </ul>
          </div>
        </div>
        <p class="mt-10 border-t border-lienzo-blanco/10 pt-6 text-xs text-lienzo-hueso/50">
          © {new Date().getFullYear()} ArteMichiko · CDMX
        </p>
      </div>
    </footer>

    <style>
      /* Cursor follower — punto dorado con lerp */
      .cursor-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 10px;
        height: 10px;
        margin: -5px 0 0 -5px;
        border-radius: 9999px;
        background: #d4af37;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.3s, transform 0.15s ease-out;
        mix-blend-mode: multiply;
      }
      .cursor-dot.visible { opacity: 1; }
      .cursor-dot.grown { transform: scale(3); background: rgba(212,175,55,0.25); border: 1px solid #d4af37; }

      /* Header direction-aware: se esconde al bajar, aparece al subir */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(253, 251, 247, 0.9);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(17, 17, 14, 0.08);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
      }
      .site-header.hidden { transform: translateY(-100%); }

      .nav-link {
        position: relative;
        transition: color 0.2s ease;
      }
      .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: #00a86b;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .nav-link:hover { color: #00965f; }
      .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      /* ── Menú móvil — hamburguesa + drawer lateral (solo <md) ── */
      .menu-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        border: 1px solid rgba(17, 17, 14, 0.15);
        background: transparent;
        color: var(--color-tinta-negra);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }
      .menu-trigger:hover {
        border-color: var(--color-jade-profundo);
        color: var(--color-jade-profundo);
        transform: translateY(-1px);
      }
      .menu-trigger:focus-visible,
      .menu-close:focus-visible,
      .menu-link:focus-visible {
        outline: 2px solid var(--color-jade-profundo);
        outline-offset: 2px;
      }

      .menu-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(17, 17, 14, 0.55);
        backdrop-filter: blur(4px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.35s ease;
      }
      .menu-overlay.open {
        opacity: 1;
        pointer-events: auto;
      }

      .menu-panel {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 1001;
        width: min(20rem, 86vw);
        transform: translateX(100%);
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
        box-shadow: -24px 0 64px rgba(17, 17, 14, 0.28);
      }
      .menu-panel.open {
        transform: translateX(0);
      }

      .menu-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        border: 1px solid rgba(17, 17, 14, 0.15);
        background: transparent;
        color: var(--color-tinta-negra);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
      }
      .menu-close:hover {
        border-color: var(--color-jade-profundo);
        color: var(--color-jade-profundo);
        background: rgba(0, 166, 107, 0.06);
      }

      .menu-link {
        display: block;
        padding: 0.875rem 0.75rem;
        border-radius: 6px;
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--color-tinta-negra);
        transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
      }
      .menu-link:hover {
        color: var(--color-jade-profundo);
        background: rgba(0, 166, 107, 0.06);
        transform: translateX(4px);
      }

      /* En móvil el CTA vive en el drawer (header sin overflow). Touch targets ≥44px
         (WCAG 2.5.8) — misma convención que .search-trigger en global.css. */
      @media (max-width: 767px) {
        .site-header a.btn-magnetic {
          display: none;
        }
        .menu-trigger,
        .menu-close {
          min-width: 44px;
          min-height: 44px;
        }
      }
      @media (min-width: 768px) {
        .menu-trigger {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .cursor-dot { display: none; }
        .site-header { transition: none; }
        .menu-overlay, .menu-panel { transition: none; }
      }
    </style>

    <script>
      // anim-ready: activa animaciones si el usuario no prefiere motion reducida
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("anim-ready");
      }
      // ── Lenis smooth scroll (base de toda la sensación premium) ──
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReduced) {
        const lenis = new Lenis({ lerp: 0.1 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        // ── Scroll progress bar ──
        const progressBar = document.getElementById("scroll-progress");
        lenis.on("scroll", ({ progress }) => {
          if (progressBar) progressBar.style.width = `${Math.min(progress, 1) * 100}%`;
        });

        // ── Back-to-top (aparece tras 600px) ──
        const backTop = document.getElementById("back-to-top");
        lenis.on("scroll", ({ scroll }) => {
          if (!backTop) return;
          if (scroll > 600) backTop.classList.add("visible");
          else backTop.classList.remove("visible");
        });
        backTop?.addEventListener("click", () => {
          lenis.scrollTo(0, { duration: 1.2 });
        });

        // ── Header direction-aware ──
        const header = document.getElementById("site-header");
        let lastY = 0;
        lenis.on("scroll", ({ scroll }) => {
          const y = scroll;
          if (y > lastY && y > 120) header?.classList.add("hidden");
          else header?.classList.remove("hidden");
          lastY = y;
        });

        // ── Magnetic buttons (gsap.quickTo, técnica investigada 2026) ──
        gsap.utils.toArray<HTMLElement>(".btn-magnetic, [data-magnetic]").forEach((el) => {
          const strength = 24;
          const xTo = gsap.quickTo(el, "x", { duration: 0.4, ease: "power3.out" });
          const yTo = gsap.quickTo(el, "y", { duration: 0.4, ease: "power3.out" });
          el.addEventListener("pointermove", (e: PointerEvent) => {
            const r = el.getBoundingClientRect();
            xTo((e.clientX - (r.left + r.width / 2)) / r.width * strength);
            yTo((e.clientY - (r.top + r.height / 2)) / r.height * strength);
          });
          el.addEventListener("pointerleave", () => { xTo(0); yTo(0); });
        });

        // ── Cursor follower (solo pointer:fine) ──
        if (window.matchMedia("(pointer: fine)").matches) {
          const dot = document.getElementById("cursor-dot");
          let mx = 0, my = 0, cx = 0, cy = 0;
          window.addEventListener("pointermove", (e) => {
            mx = e.clientX; my = e.clientY;
            dot?.classList.add("visible");
          });
          document.addEventListener("mouseleave", () => dot?.classList.remove("visible"));
          document.querySelectorAll("[data-cursor]").forEach((el) => {
            el.addEventListener("mouseenter", () => dot?.classList.add("grown"));
            el.addEventListener("mouseleave", () => dot?.classList.remove("grown"));
          });
          (function raf() {
            cx += (mx - cx) * 0.12;
            cy += (my - cy) * 0.12;
            if (dot) dot.style.transform = `translate(${cx}px, ${cy}px)`;
            requestAnimationFrame(raf);
          })();
        }
      }

      // ── Menú móvil — drawer lateral (funciona también con reduced-motion) ──
      const menuTrigger = document.getElementById("menu-abrir");
      const menuCloseBtn = document.getElementById("menu-cerrar");
      const menuOverlay = document.getElementById("menu-overlay");
      const menuPanel = document.getElementById("menu-movil");

      let menuLastFocus: HTMLElement | null = null;

      const openMenu = (): void => {
        if (!menuPanel || !menuOverlay || !menuTrigger) return;
        menuLastFocus = document.activeElement as HTMLElement | null;
        menuPanel.removeAttribute("inert");
        menuOverlay.setAttribute("aria-hidden", "false");
        menuTrigger.setAttribute("aria-expanded", "true");
        document.body.classList.add("no-scroll");
        menuOverlay.classList.add("open");
        menuPanel.classList.add("open");
        window.setTimeout(() => menuCloseBtn?.focus(), 80);
      };

      const closeMenu = (restoreFocus = true): void => {
        if (!menuPanel || !menuOverlay || !menuTrigger) return;
        menuOverlay.classList.remove("open");
        menuPanel.classList.remove("open");
        menuOverlay.setAttribute("aria-hidden", "true");
        menuTrigger.setAttribute("aria-expanded", "false");
        document.body.classList.remove("no-scroll");
        menuPanel.setAttribute("inert", "");
        if (restoreFocus) menuLastFocus?.focus();
      };

      menuTrigger?.addEventListener("click", () => {
        if (menuPanel?.classList.contains("open")) closeMenu();
        else openMenu();
      });
      menuCloseBtn?.addEventListener("click", () => closeMenu());
      menuOverlay?.addEventListener("click", () => closeMenu());

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !menuPanel?.classList.contains("open")) return;
        closeMenu();
      });

      // Foco atrapado dentro del drawer (Tab cíclico, WCAG 2.1.2)
      menuPanel?.addEventListener("keydown", (e) => {
        if (e.key !== "Tab" || !menuPanel.classList.contains("open")) return;
        const focusables = Array.from(
          menuPanel.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !menuPanel.contains(active))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      });

      // Cerrar al navegar con un enlace del drawer
      menuPanel?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => closeMenu(false));
      });

      // Si el viewport crece a md+, forzar cierre (el drawer solo existe <md)
      const mqDesktop = window.matchMedia("(min-width: 768px)");
      mqDesktop.addEventListener?.("change", (e) => {
        if (e.matches) closeMenu(false);
      });
    </script>
  </body>
</html>
